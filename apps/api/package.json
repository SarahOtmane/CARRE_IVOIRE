{
  "name": "@carre-ivoire/api",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "db:seed:all": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "pretest:e2e": "NODE_ENV=test DB_NAME=carre_ivoire_test jest --config ./test/jest-e2e.json --runInBand --testPathPattern=_setup-db",
    "test:e2e": "NODE_ENV=test DB_NAME=carre_ivoire_test jest --config ./test/jest-e2e.json --testPathIgnorePatterns=_setup-db --runInBand"
  },
  "dependencies": {
    "@carre-ivoire/types": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.2.0",
    "joi": "^17.13.0",
    "mysql2": "^3.6.0",
    "nest-winston": "^1.9.4",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "puppeteer-core": "^22.15.0",
    "reflect-metadata": "^0.1.13",
    "resend": "^4.8.0",
    "rxjs": "^7.8.2",
    "sequelize": "^6.35.0",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.33.5",
    "stripe": "^17.0.0",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@carre-ivoire/config": "*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/jest": "^29.5.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/passport-jwt": "^4.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
