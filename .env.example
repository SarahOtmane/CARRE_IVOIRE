# Application
NODE_ENV=development
PORT=3000

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carre_ivoire
DB_USER=carre_user
DB_PASSWORD=changeme

# JWT (générer avec : openssl rand -base64 32)
JWT_SECRET=change_me_at_least_32_characters_long
JWT_EXPIRATION=1h
REFRESH_TOKEN_SECRET=change_me_refresh_at_least_32_chars
REFRESH_TOKEN_EXPIRATION=7d

# Stripe (clés disponibles sur https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # Requis en production

# Email (SMTP — laisser vide pour logger en console en dev)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=commandes@carre-ivoire.fr

# URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173   # Requis en production

# Compte admin initial (créé par le seeder)
ADMIN_EMAIL=admin@carre-ivoire.fr
ADMIN_PASSWORD=ChangeMe1234!

# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api/v1
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
